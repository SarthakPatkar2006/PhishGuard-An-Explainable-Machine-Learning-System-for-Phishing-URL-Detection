# Copy this file to .env and fill in your real values
# Never commit the actual .env file to Git!

# MongoDB Atlas connection
MONGODB_URL_KEY=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# DagsHub settings (used by model_trainer.py for MLflow logging)
DAGSHUB_REPO_OWNER=YourDagsHubUsername
DAGSHUB_REPO_NAME=Network-Security-Phishing-Detection

# MongoDB collection settings (optional - defaults already in constants)
# DATA_INGESTION_COLLECTION_NAME=NetworkData
# DATA_INGESTION_DATABASE_NAME=NetworkSecurity
